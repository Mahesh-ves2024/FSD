            <input type="radio" name="q2" value="SQL"> SQL<br><br>

            <button type="submit">Submit</button>
        </form>
    `);
});

app.post("/submit", (req, res) => {
    let score = 0;

    if (req.body.q1 === "Java") score++;
    if (req.body.q2 === "CSS") score++;

    res.send(`
        <h2>Quiz Result</h2>
        <h3>Your Score: ${score}/2</h3>
        <a href="/">Try Again</a>
    `);
});

app.listen(3000, () => {
